# --- Infrastructure ---
DATABASE_URL=postgresql://weathergpt:weathergpt@db:5432/weathergpt
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me

# --- AI (read by ai/config.py) ---
# Groq API key. Leave empty to run without the LLM (rule-based fallback).
GROQ_API_KEY=
# Optional; default is openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
# Optional JSON map of city -> verified IMD district obj_id, e.g. {"Bhopal": 123}
# Leave empty until you have verified IDs; unconfigured cities report
# "Weather alert data is not configured for this location."
IMD_DISTRICT_IDS=

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
